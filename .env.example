# Server
PORT=5000
APP_URL=http://localhost:5000   # public URL of the deployed API (used for Paymob callbacks)

# Database (MongoDB connection string, e.g. from MongoDB Atlas)
DB_URL=

# Redis (used by the rate limiter), e.g. from Redis Cloud: rediss://default:<password>@<host>:<port>
REDIS_URL=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Booking
BOOKING_PRICE_EGP=100

# Paymob (use TEST mode keys from the Paymob dashboard)
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_HMAC_SECRET=

# Email (booking confirmation)
EMAIL_USER=
EMAIL_PASSWORD=
